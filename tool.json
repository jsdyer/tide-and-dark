        "url": "https://coolcode.ca/tide-and-dark/daylight-status.json",
        "path": [
          "start"
        ],
        "end_path": [
          "through"
        ]
      },
      {
        "label": "Independent model dates",
        "url": "https://coolcode.ca/tide-and-dark/status.json",
        "path": [
